App(
    appid="flipper_rf_lab",

    name="Flipper RF Lab",

    apptype=FlipperAppType.EXTERNAL,
    entry_point="flipper_rf_lab_main",

    cdefines=["APP_FLIPPER_RF_LAB"],

    requires=[
        "gui",
        "storage",
        "notification",
        "furi",
        "furi_hal",
    ],
    stack_size=4 * 1024,   # main thread only — workers have their own stacks (FIX 12)
    order=10,
    fap_icon="assets/flipper_rf_lab_10px.png",

    fap_category="RF",
    fap_icon_assets="assets",
    # Explicit source list so the host-only unit runner (tests/) is NOT built
    # into the firmware .fap — it has its own main() and mocks the SDK.
    sources=[
        "core/*.c",
        "core/hal/*.c",
        "core/math/*.c",
        "analysis/*.c",
        "storage/*.c",
        "research/*.c",
        "ui/*.c",
    ],
)
